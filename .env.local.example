# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of this deployment (no trailing slash).
# On AWS Lightsail: your static IP, domain, or CloudFront distribution URL.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Image Tools

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://example.com

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Lightsail managed DB endpoint format:
# postgresql://masterutils:PASSWORD@<lightsail-db-endpoint>:5432/masterutils
DATABASE_URL=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Stripe (publishable key for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Payment Links (create in Stripe dashboard)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ANNUAL=

# Stripe secret + webhook signing secret
# API keys: https://dashboard.stripe.com/apikeys
# Webhook signing secret: Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Production endpoint: https://utilio.solutions/api/webhooks/stripe (API version 2026-05-27.dahlia)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Managed Payments — Hamlet (e-book) product (create via scripts/create-hamlet-product.mjs)
STRIPE_HAMLET_PRODUCT_ID=
STRIPE_HAMLET_PRICE_ID=

# Stripe Buy Button embed for Pro subscription (Stripe Dashboard → Payment Links / Buy button)
NEXT_PUBLIC_STRIPE_PRO_BUY_BUTTON_ID=

# Donation product for variable-amount Checkout (Stripe Dashboard → Products)
DONATION_PRODUCT_ID=

# Optional bearer token to protect POST /api/stripe/create-product in production
STRIPE_SETUP_TOKEN=

# ── AWS S3 (file storage for export history and API assets) ──────────────────
# IAM user credentials — create a dedicated user with s3:PutObject/GetObject/DeleteObject
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=master-utils-uploads

# ── Swim email (Amazon SES) ───────────────────────────────────────────────────
# Reuses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above (IAM needs ses:SendEmail).
# Verify utilio.solutions (or SWIM_EMAIL_FROM) in SES and request production access.
SWIM_EMAIL_FROM=meets@utilio.solutions
SWIM_EMAIL_FROM_NAME=Utilio Swim
# Optional if SES is in a different region than AWS_REGION
AWS_SES_REGION=us-east-1
NEXT_PUBLIC_SWIM_URL=https://swim.utilio.solutions
