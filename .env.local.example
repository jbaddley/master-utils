# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of this deployment (no trailing slash).
# On AWS Lightsail: your static IP, domain, or CloudFront distribution URL.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Image Tools

# ── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# PostHog project API key
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host (default: https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (publishable key for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Payment Links (create in Stripe dashboard)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ANNUAL=

# ── API / server-side (never NEXT_PUBLIC_) ────────────────────────────────────
# Supabase service-role key for server-side DB writes (API routes, webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret + webhook signing secret (used in Supabase Edge Function)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
